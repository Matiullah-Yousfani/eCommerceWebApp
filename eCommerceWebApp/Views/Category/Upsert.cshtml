@model Category

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(Model.Category_Id == 0 ? "Create Category" : "Update Category")</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        body {
            padding: 20px;
            background-color: #f3f4f6; /* Light background */
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container {
            background-color: #fff; /* White container */
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            max-width: 600px;
            margin: auto;
        }

        .form-heading {
            margin-bottom: 20px;
            font-size: 24px;
            font-weight: bold;
            color: #343a40; /* Dark text */
        }

        .form-label {
            font-weight: bold;
        }

        .form-control {
            margin-bottom: 15px;
            border-radius: 6px;
            padding: 10px;
            border: 1px solid #ced4da; /* Light border */
        }

        .btn-submit {
            margin-right: 10px;
        }

        .btn-back {
            background-color: #dc3545; /* Red button */
            border-color: #dc3545;
        }

            .btn-back:hover {
                background-color: #c82333; /* Darker red on hover */
                border-color: #bd2130;
            }
    </style>
</head>
<body>

    <div class="container">
        @if (Model.Category_Id == 0)
        {
            <h3 class="form-heading">Create Category</h3>
        }
        else
        {
            <h3 class="form-heading">Update Category</h3>
        }

        <form method="post">
            <input asp-for="Category_Id" hidden />

            <div class="form-group">
                <label class="form-label">Category Name</label>
                <input type="text" class="form-control" asp-for="CategoryName" placeholder="Enter Category" />
            </div>

            @if (Model.Category_Id == 0)
            {
                <button class="btn btn-outline-primary btn-submit" asp-action="Upsert" type="submit">Create</button>
            }
            else
            {
                <button class="btn btn-outline-primary btn-submit" asp-action="Upsert" type="submit">Update</button>
            }

            <a class="btn btn-outline-danger" class="btn btn-back" asp-controller="Category" asp-action="Index">Back to List</a>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
