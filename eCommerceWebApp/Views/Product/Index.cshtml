@model List<Product>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Category Page</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        body {
            padding: 20px;
            background-color: #f3f4f6;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container {
            background-color: #fff;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            max-width: 1200px;
            margin: auto;
        }

        .btn-custom {
            background-color: orange;
            color: #fff;
            border: none;
            padding: 12px 24px;
            border-radius: 30px;
            text-transform: uppercase;
            font-weight: 600;
            transition: background 0.3s, box-shadow 0.3s, transform 0.3s;
            box-shadow: 0 4px 8px rgba(108, 117, 125, 0.3);
        }

            .btn-custom:hover {
                background-color: lightblue;
                box-shadow: 0 4px 12px rgba(108, 117, 125, 0.5);
                transform: translateY(-2px);
            }

        .table {
            border-radius: 12px;
            overflow: hidden;
        }

            .table thead {
                background-color: #343a40;
                color: #fff;
            }

            .table tbody tr {
                transition: background-color 0.3s;
            }

                .table tbody tr:hover {
                    background-color: #e9ecef;
                }

        .btn-outline-warning,
        .btn-outline-danger {
            border-width: 2px;
        }
    </style>
</head>
<body>

    <div class="container">
        <h1 class="mb-4">Products</h1>

        <a class="btn btn-custom mb-3" asp-action="Upsert" asp-controller="Product">Create Product</a>

        <div class="table-responsive">
            <table class="table table-bordered table-hover table-striped">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Category</th>
                        <th class="col-2">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Product_Name</td>
                            <td>@item.Description</td>
                            <td>@item.Price</td>
                            <td>@item.StockQuantity</td>
                            <td>@item.Category.CategoryName</td>
                            <td>
                                <a class="btn btn-outline-warning btn-sm" asp-controller="Product" asp-action="Upsert" asp-route-id="@item.Product_Id" style="margin-right: 5px;">Edit</a>
                                <a class="btn btn-outline-danger btn-sm" asp-controller="Product" asp-action="Delete" asp-route-id="@item.Product_Id">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
